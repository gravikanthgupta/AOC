managed implementation in class zbp_ivar_r_travel unique;
// implementation in class zbp_ivar_r_travel unique;
// Guidelines and best practice for definition to be followed
// 2 - is latest guidelines. 1 - old guidelines
strict ( 2 );

// Add draft feature at BO level
with draft;

// Define the behaviour for root entity Travel
define behavior for zivar_r_travel alias Travel
// Make the behaviour pool/implementation for travel entity
implementation in class zbp_ivar_r_travel unique
//It tells to RAP framework which table needs to update
persistent table /dmo/travel_m

// How the RAP should handle the locks -
// If a travel request is locked then other users cannot edit the childs - Bookings & Supplements
lock master

// Mandatory to use total etag
total etag LastChangedAt

// Authorization. Instance & Global
// Instance : Based on the each record
// Global: Based on table wise
authorization master ( instance )

// Specify the draft table - will be created by RAP framework
draft table zivar_d_travel

// etag for concurrency control
etag master LastChangedAt
early numbering
with additional save
{
  // Here are the operations which RAP will generate automatically (Manage)
  create ( authorization : global );
  update;
  delete;



  // A Booking can only be created with travel request
  // With out travel request, we cannot create Booking
  // Dynamic feature control at the time of creation of Booking. Creation of booking isntances
  // controlled by dynamic feature based on rejection or not

  // Add draft also for booking
  association _Booking { create ( features : instance ); with draft; }

  // Its a piece of code which is intented to be only consumed within our RAP BO
  // We cannot use outside RAP
  // Reusable purpose. We can reuse many aread
  internal action reCalcTotalPrice;

  // Define determination to execute the code when
  // booking fee or curr code changes so we calc total price
  determination calculateTotalPrice on modify { create; field BookingFee, CurrencyCode; }

  // Checking custom business object rules
  validation validateHeaderData on save { create; field CustomerId, BeginDate, EndDate; }

  // Static feature control
  field ( readonly ) TravelId, TotalPrice, CreatedBy, CreatedAt, LastChangedAt, LastChangedBy;
  field ( mandatory ) AgencyId, CustomerId, BeginDate, EndDate, OverallStatus, BookingFee, CurrencyCode;

  // Instance bound factory data action for copy button
  // Cardinality how many records can be copied at a type. Only one for our scenario
  factory action copyTravel [1];

  // Create a new determine action
  determine action validationCustomer { validation validateHeaderData; }
  // Adding side effects which inform RAP to reload the total price if the booking fee changed
  side effects
  {
    field BookingFee affects field TotalPrice;
    determine action validationCustomer executed on field CustomerId affects messages;
  }

  // adding the draft actions
  draft determine action Prepare;
  draft action Edit;
  draft action Resume;
  draft action Activate;
  draft action Discard;

  mapping for /dmo/travel_m
    {
      TravelId      = travel_id;
      AgencyId      = agency_id;
      CustomerId    = customer_id;
      BeginDate     = begin_date;
      EndDate       = end_date;
      TotalPrice    = total_price;
      Bookingfee    = booking_fee;
      currencyCode  = currency_code;
      Description   = description;
      OverallStatus = overall_status;
      CreatedBy     = created_by;
      LastChangedBy = last_changed_by;
      CreatedAt     = created_at;
      LastChangedAt = last_changed_at;
    }
}

// Define the behaviour for Child entity Booking
define behavior for ZIVAR_R_bOOKING alias Booking
// Make the behaviour pool/implementation for Booking entity
implementation in class zbp_ivar_r_booking unique

//It tells to RAP framework which table needs to update
persistent table /dmo/booking_m


lock dependent by _Travel
authorization dependent by _Travel

//Add draft table
draft table zivar_d_book

etag master LastChangedAt
early numbering
{
  update;
  delete;

  // Static feature control
  field ( readonly ) TravelId, BookingId;
  field ( mandatory ) CarrierId, ConnectionId, FlightDate, BookingStatus;

    determination calculateTotalPrice on modify { create; field FlightPrice, CurrencyCode; }
//  determination calculateTotalPrice on modify { create; }

  //  field ( readonly ) TravelId;
  // Reconfirm that booking will create with travel draft
  association _Travel { with draft; }

  // Assure that child entity also manage with draft
  association _BookingSupplement { create; with draft; }

  // Adding side effects which inform RAP to reload the total price if the booking fee changed
  side effects
  {
    field FlightPrice affects field _Travel.TotalPrice;
  }

  mapping for /dmo/booking_m
    {
      TravelId      = travel_id;
      BookingId     = Booking_Id;
      BookingDate   = Booking_Date;
      CustomerId    = Customer_Id;
      CarrierId     = carrier_Id;
      ConnectionId  = connection_id;
      FlightDate    = flight_date;
      FlightPrice   = flight_price;
      currencyCode  = currency_code;
      BookingStatus = booking_status;
      LastChangedAt = last_changed_at;
    }
}

// Define the behaviour for Child entity Booking Suppliments
define behavior for zivar_r_booksuppl alias BookSuppl
// Make the behaviour pool/implementation for Booking Supplement entity
implementation in class zbp_ivar_r_booksuppl unique
persistent table /dmo/booksuppl_m

lock dependent by _Travel
authorization dependent by _Travel

draft table zivar_d_booksp
etag master LastChangedAt
early numbering
{
  update;
  delete;
  field ( readonly ) TravelId, BookingId, BookingSupplementId, LastChangedAt;

  field ( mandatory ) Price, SupplementId;

  //  field ( readonly ) TravelId, BookingId;
  association _Travel { with draft; }
  association _Booking { with draft; }

    determination calculateTotalPrice on modify { create; field Price, CurrencyCode; }
//  determination calculateTotalPrice on modify { create; }

  // Adding side effects which inform RAP to reload the total price if the booking fee changed
  side effects
  {
    field Price affects field _Travel.TotalPrice;
  }

  mapping for /dmo/booksuppl_m
    {
      TravelId            = travel_id;
      BookingId           = Booking_Id;
      BookingSupplementId = booking_supplement_id;
      SupplementId        = supplement_id;
      Price               = price;
      CurrencyCode        = currency_code;
      LastChangedAt       = last_changed_at;
    }
}